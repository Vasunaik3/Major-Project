PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_onion_storage
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Storage Administrator

# Optional protection for the simulator's sensor-ingestion API.
SENSOR_INGEST_TOKEN=

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_DEVICE_ID=SIMULATOR_01
SIMULATOR_SCENARIO=NORMAL
SIMULATOR_API_URL=
SIMULATOR_RAMP_DURATION_MS=45000
SIMULATOR_HOLD_DURATION_MS=20000
SIMULATOR_RECOVERY_DURATION_MS=45000

# Environment defaults. Admin settings in MongoDB override these live.
STORAGE_TEMP_CRITICAL_LOW_C=23
STORAGE_TEMP_WARNING_LOW_C=25
STORAGE_TEMP_WARNING_HIGH_C=30
STORAGE_TEMP_CRITICAL_HIGH_C=34
STORAGE_HUMIDITY_CRITICAL_LOW_PERCENT=45
STORAGE_HUMIDITY_WARNING_LOW_PERCENT=55
STORAGE_HUMIDITY_WARNING_HIGH_PERCENT=75
STORAGE_HUMIDITY_CRITICAL_HIGH_PERCENT=85
STORAGE_GAS_CRITICAL_LOW_LEVEL=50
STORAGE_GAS_WARNING_LOW_LEVEL=100
STORAGE_GAS_WARNING_HIGH_LEVEL=300
STORAGE_GAS_CRITICAL_HIGH_LEVEL=500

FAN_ON_TEMP_C=28
FAN_OFF_TEMP_C=24
FAN_ON_HUMIDITY_PERCENT=78
FAN_OFF_HUMIDITY_PERCENT=72
FAN_ON_GAS_LEVEL=350
FAN_OFF_GAS_LEVEL=250
FAN_MIN_ON_DURATION_MS=15000
FAN_MIN_OFF_DURATION_MS=10000

STORAGE_ABNORMAL_SUSTAINED_MS=60000
STORAGE_ABNORMAL_MIN_READINGS=3
STORAGE_MAX_READING_GAP_MS=15000
REPORT_MAX_SAMPLE_GAP_MS=15000
SENSOR_STALE_AFTER_MS=20000
ALERT_MONITOR_ENABLED=true
ALERT_MONITOR_INTERVAL_MS=5000
ALERT_SIGNIFICANT_CHANGE_COOLDOWN_MS=30000
IMAGE_MAX_SIZE_MB=5
